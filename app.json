        "backgroundColor": "#0D0D0D"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "aab5225a-ada9-4e7a-b428-63ea8a590198"
      }
    },
    "owner": "josuedevbr"
  }
